POSTGRES_DB=matchgrid
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-random-password

SECRET_KEY=replace-with-a-long-random-secret-key

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_PASSWORD=replace-with-a-strong-random-password
REDIS_URL=redis://localhost:6379/0

DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/matchgrid

CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
MATCH_REMINDER_MINUTES=60
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_REQUESTS=100
RATE_LIMIT_AUTHENTICATED_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=60
AUDIT_ADMIN_USER_IDS=

# Dedicated runtime and migration database credentials
MATCHGRID_APP_USER=matchgrid_app
MATCHGRID_APP_PASSWORD=replace_with_a_strong_random_password
MATCHGRID_MIGRATOR_USER=matchgrid_migrator
MATCHGRID_MIGRATOR_PASSWORD=replace_with_a_different_strong_random_password
